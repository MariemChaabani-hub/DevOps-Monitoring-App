{
 "server": {
    "id": "default-server",
    "name": "default-server",
    "location": "Local PC"
  },
  "api": {
    "url": "http://localhost:3000",
    "timeout": 120,
    "max_retries": 3,
    "backoff_factor": 1.0
  },
  "collection": {
    "interval": 300,
    "enabled_metrics": [
      "cpu",
      "ram",
      "disk",
      "network",
      "uptime"
    ]
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "file": true,
    "file_path": "agent.log",
    "max_file_size_mb": 10,
    "backup_count": 5
  },
  "behavior": {
    "check_api_health_on_start": true,
    "continue_if_api_down": true,
    "log_statistics_interval": 60
  }
}