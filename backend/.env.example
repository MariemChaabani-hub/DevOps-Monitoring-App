# Environment Configuration for CPU Alerting System
# Copy this to .env file and fill in your actual values

# ============================================
# Email Configuration (for real email alerts)
# ============================================

# Gmail example (recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Other email providers examples:
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASS=your-password

# ============================================
# MongoDB Configuration (optional)
# ============================================

# Default: mongodb://localhost:27017/pfe-monitoring
# If you need authentication:
MONGODB_URI=mongodb://localhost:27017/pfe-monitoring

# If MongoDB requires username/password:
# MONGODB_URI=mongodb://username:password@localhost:27017/pfe-monitoring?authSource=admin

# ============================================
# Application Configuration
# ============================================

# Development or production
NODE_ENV=development

# Backend port
PORT=3000

# Admin email for alerts (optional - defaults to hardcoded email)
# ADMIN_EMAIL=your-admin@example.com

# ============================================
# Alert Configuration (optional)
# ============================================

# CPU thresholds (if you want to make them configurable)
# CPU_WARNING_THRESHOLD=80
# CPU_CRITICAL_THRESHOLD=90

# Deduplication window in seconds
# ALERT_COOLDOWN=60

# ============================================
# Frontend Configuration (if applicable)
# ============================================

# REACT_APP_API_URL=http://localhost:3000
# REACT_APP_WEBSOCKET_URL=ws://localhost:3000
