# Environment Configuration for CPU Alerting System
# Copy this to .env file and fill in your actual values

# ============================================
# Email Configuration (for real email alerts)
# ============================================

# Resend HTTP API (recommended) — used automatically when set, takes
# priority over SMTP below. Works over HTTPS (port 443), so it works from
# hosts where outbound SMTP (25/465/587) is blocked by the provider.
# Get a key at https://resend.com — free tier, no domain verification
# needed if you keep RESEND_FROM at its default.
# RESEND_API_KEY=re_your_api_key

# Sender address for Resend. Defaults to onboarding@resend.dev (Resend's
# test address — no domain verification needed) if not set. Note: that
# address can only send to the email of the Resend account itself — fine
# for a single admin recipient, not for sending to arbitrary addresses.
# RESEND_FROM=onboarding@resend.dev

# --- SMTP fallback (used only if RESEND_API_KEY is not set) ---

# Gmail example (recommended for SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Other email providers examples:
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASS=your-password

# ============================================
# MongoDB Configuration (optional)
# ============================================

# Default: mongodb://localhost:27017/pfe-monitoring
# If you need authentication:
MONGODB_URI=mongodb://localhost:27017/pfe-monitoring

# If MongoDB requires username/password:
# MONGODB_URI=mongodb://username:password@localhost:27017/pfe-monitoring?authSource=admin

# ============================================
# Application Configuration
# ============================================

# Development or production
NODE_ENV=development

# Backend port
PORT=3000

# Admin email for alerts (optional - defaults to hardcoded email)
# ADMIN_EMAIL=your-admin@example.com

# ============================================
# Authentication (JWT + bcrypt)
# ============================================

# Secret used to sign/verify JWT tokens. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# Password for the default admin account seeded on first startup.
# Change this immediately after first login.
ADMIN_PASSWORD=ChangeMe123!

# ============================================
# Alert Configuration (optional)
# ============================================

# CPU thresholds (if you want to make them configurable)
# CPU_WARNING_THRESHOLD=80
# CPU_CRITICAL_THRESHOLD=90

# Deduplication window in seconds
# ALERT_COOLDOWN=60

# ============================================
# Frontend Configuration (if applicable)
# ============================================

# REACT_APP_API_URL=http://localhost:3000
# REACT_APP_WEBSOCKET_URL=ws://localhost:3000
